  {
    "name": "missing choices",
    "schema": {
      "type": "object",
      "properties": {
        "chips": {
          "type": "array",
          "x-format": "chips",
          "items": {
            "type": "string"
          }
        },
        "seg": {
          "type": "string",
          "x-format": "segmented"
        },
        "rank": {
          "type": "array",
          "x-format": "ranking",
          "items": {
            "$ref": "#/definitions/choice"
          }
        },
        "matrix": {
          "type": "object",
          "x-format": "matrix",
          "properties": {
            "a": {
              "type": "string"
            }
          }
        },
        "pic": {
          "type": "string",
          "x-format": "image-choice",
          "enum": [
            "a",
            "b"
          ]
        },
        "svg": {
          "type": "array",
          "x-format": "svg-part-picker",
          "items": {
            "type": "string"
          }
        }
      },
      "definitions": {
        "choice": {
          "type": "string",
          "enum": [
            "x",
            "y"
          ]
        }
      }
    },
    "issues": [
      {
        "path": "/properties/chips",
        "code": "format-choices",
        "severity": "error",
        "message": "\"chips\" needs choices on \"items\": an \"enum\", or a \"oneOf\" of {\"const\", \"title\"} branches; the field falls back to its default editor."
      },
      {
        "path": "/properties/matrix",
        "code": "format-choices",
        "severity": "error",
        "message": "\"matrix\" needs \"properties\" with choices (an \"enum\", or a \"oneOf\" of {\"const\", \"title\"} branches), one per row; the field falls back to its default editor."
      },
      {
        "path": "/properties/pic",
        "code": "format-choices",
        "severity": "error",
        "message": "\"image-choice\" needs a \"oneOf\" of {\"const\", \"title\", \"x-image\"} branches; the field falls back to its default editor."
      },
      {
        "path": "/properties/seg",
        "code": "format-choices",
        "severity": "error",
        "message": "\"segmented\" needs choices: an \"enum\", or a \"oneOf\" of {\"const\", \"title\"} branches; the field falls back to its default editor."
      },
      {
        "path": "/properties/svg",
        "code": "format-choices",
        "severity": "error",
        "message": "\"svg-part-picker\" needs an \"x-svg-asset\"; the field falls back to its default editor."
      }
    ]
  },
