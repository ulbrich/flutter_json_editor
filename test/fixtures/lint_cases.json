  {
    "name": "format on wrong type",
    "schema": {
      "type": "object",
      "properties": {
        "s": {
          "type": "string",
          "x-format": "slider"
        },
        "c": {
          "x-format": "consent"
        },
        "d": {
          "type": "boolean",
          "format": "date"
        },
        "n": {
          "type": [
            "string",
            "null"
          ],
          "x-format": "textarea"
        }
