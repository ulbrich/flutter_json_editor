    "issues": [
      {
        "path": "/properties/a",
        "code": "keyword-type",
        "severity": "error",
        "message": "\"x-accept\" must be an array of strings."
      },
      {
        "path": "/properties/h",
        "code": "keyword-type",
        "severity": "error",
        "message": "\"x-hidden\" must be true or false."
      },
      {
        "path": "/properties/r",
        "code": "keyword-type",
        "severity": "error",
        "message": "\"x-rows\" must be an integer."
      }
    ]
  },
  {
    "name": "misplaced keywords",
    "schema": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "string",
          "x-rows": 3
        },
        "unit": {
          "type": "number",
          "x-format": "slider",
          "x-unit": "kg"
        },
        "fold": {
          "type": "object",
          "x-collapsed": true,
          "properties": {
            "a": {
              "type": "string"
            }
          }
        },
        "raw": {
          "type": "string",
          "x-mask-raw": true
        },
        "mask": {
          "type": "integer",
          "x-mask": "000"
