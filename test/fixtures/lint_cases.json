      {
        "path": "/properties/b",
        "code": "calc-cycle",
        "severity": "error",
        "message": "\"x-calc\" of \"b\" depends on its own value; it keeps its last value."
      },
      {
        "path": "/properties/c",
        "code": "calc-cycle",
        "severity": "error",
        "message": "\"x-calc\" of \"c\" depends on its own value; it keeps its last value."
      },
      {
        "path": "/properties/self",
        "code": "calc-cycle",
        "severity": "error",
        "message": "\"x-calc\" of \"self\" depends on its own value; it keeps its last value."
      }
    ]
  },
  {
    "name": "calc through refs and branches",
    "schema": {
      "type": "object",
      "properties": {
        "addr": {
          "$ref": "#/definitions/address"
        },
        "kind": {
          "type": "string",
          "enum": [
            "a",
            "b"
          ]
        },
        "zip2": {
          "type": "string",
          "x-calc": {
            "cat": [
              {
                "var": "addr.zip"
              },
              {
                "var": "extra"
              },
              {
                "var": "meta.anything"
              },
              {
                "var": "remote.x"
              }
            ]
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "remote": {
          "$ref": "https://example.com/schema.json"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "a"
          }
        }
      },
      "then": {
        "properties": {
          "extra": {
            "type": "string"
          }
        }
      },
      "definitions": {
        "address": {
          "type": "object",
          "properties": {
            "zip": {
              "type": "string"
            }
          }
        }
      }
    },
    "issues": []
  },
