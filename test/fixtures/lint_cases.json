        "path": "/properties/c",
        "code": "format-type",
        "severity": "error",
        "message": "\"consent\" needs \"type\": \"boolean\"; the field falls back to its default editor."
      },
      {
        "path": "/properties/d",
        "code": "format-type",
        "severity": "error",
        "message": "\"date\" needs \"type\": \"string\", \"integer\" or \"number\"; the field falls back to its default editor."
      },
      {
        "path": "/properties/s",
        "code": "format-type",
        "severity": "error",
        "message": "\"slider\" needs \"type\": \"number\" or \"integer\"; the field falls back to its default editor."
      }
    ]
