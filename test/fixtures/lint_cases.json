  {
    "name": "calculations",
    "schema": {
      "type": "object",
      "properties": {
        "qty": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "type": "integer"
              },
              "p": {
                "type": "number"
              },
              "s": {
                "type": "number",
                "x-calc": {
                  "*": [
                    {
                      "var": ".q"
                    },
                    {
                      "var": ".p"
                    },
                    {
                      "var": ".nope"
                    }
                  ]
                }
              }
            }
          }
        },
        "total": {
          "type": "number",
          "x-calc": {
            "reduce": [
              {
                "var": "items"
              },
              {
                "+": [
                  {
                    "var": "accumulator"
                  },
                  {
                    "var": "current.s"
                  }
                ]
              },
              0
            ]
          }
        },
        "first": {
          "type": "number",
          "x-calc": {
            "var": "items.0.s"
          }
        },
        "bad": {
          "type": "number",
          "x-calc": {
            "sum": [
              {
                "var": "qty2"
              },
              {
                "var": [
                  "qty",
                  0
                ]
              },
              1
            ]
          }
        },
        "local": {
          "type": "number",
          "x-calc": {
            "var": ".qty"
          }
        }
      }
    },
    "issues": [
      {
        "path": "/properties/bad",
        "code": "calc-operator",
        "severity": "error",
        "message": "\"x-calc\" uses the unknown operator \"sum\"; the field stays empty. Known: var missing missing_some if ?: and or ! !! == != === !== < <= > >= + - * / % min max round map filter reduce all none some merge in count cat substr log."
      },
      {
        "path": "/properties/bad",
        "code": "calc-var",
        "severity": "warning",
        "message": "\"x-calc\" reads \"qty2\", which isn't a field of the form."
      },
      {
        "path": "/properties/items/items/properties/s",
        "code": "calc-var",
        "severity": "warning",
        "message": "\"x-calc\" reads \".nope\", which isn't a field of the form."
      }
    ]
  },
  {
    "name": "calculation cycle",
    "schema": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer",
          "x-calc": {
            "+": [
              {
                "var": "b"
              },
              1
            ]
          }
        },
        "b": {
          "type": "integer",
          "x-calc": {
            "+": [
              {
                "var": "c"
              },
              1
            ]
          }
        },
        "c": {
          "type": "integer",
          "x-calc": {
            "var": "a"
          }
        },
        "d": {
          "type": "integer",
          "x-calc": {
            "var": "a"
          }
        },
        "self": {
          "type": "integer",
          "x-calc": {
            "var": "self"
          }
        }
      }
    },
    "issues": [
      {
        "path": "/properties/a",
        "code": "calc-cycle",
        "severity": "error",
        "message": "\"x-calc\" of \"a\" depends on its own value; it keeps its last value."
