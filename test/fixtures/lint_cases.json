  {
    "name": "scale ranges and labels",
    "schema": {
      "type": "object",
      "properties": {
        "wide": {
          "type": "integer",
          "x-format": "linear-scale",
          "minimum": 1,
          "maximum": 20
        },
        "faces": {
          "type": "integer",
          "x-format": "emoji-scale",
          "minimum": 1,
          "maximum": 7
        },
        "one": {
          "type": "integer",
          "x-format": "nps",
          "minimum": 3,
          "maximum": 3
        },
        "labels": {
          "type": "integer",
          "x-format": "emoji-scale",
          "x-labels": [
            "bad",
            "ok",
            "good"
          ]
        },
        "excl": {
          "type": "integer",
          "x-format": "linear-scale",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 5.5
        }
      }
    },
    "issues": [
      {
        "path": "/properties/faces",
        "code": "scale-range",
        "severity": "error",
        "message": "\"emoji-scale\" shows 2 to 5 steps, not 7 (1 to 7); the field falls back to its default editor."
      },
      {
        "path": "/properties/labels",
        "code": "scale-labels",
        "severity": "warning",
        "message": "\"x-labels\" has 3 labels for 5 steps."
      },
      {
        "path": "/properties/one",
        "code": "scale-range",
        "severity": "error",
        "message": "\"nps\" shows 2 to 11 steps, not 1 (3 to 3); the field falls back to its default editor."
      },
      {
        "path": "/properties/wide",
        "code": "scale-range",
        "severity": "error",
        "message": "\"linear-scale\" shows 2 to 11 steps, not 20 (1 to 20); the field falls back to its default editor."
      }
    ]
  },
  {
    "name": "large data",
    "schema": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "x-format": "file-data",
          "items": {
            "type": "string"
          }
        },
        "photo": {
          "type": "string",
          "x-format": "image-data"
        },
        "gallery": {
          "type": "array",
          "x-format": "image-data",
          "x-max-width": 800,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "issues": [
      {
        "path": "/properties/files",
        "code": "large-data",
        "severity": "warning",
        "message": "An array of \"file-data\" without \"maxItems\": every file is stored in the data as base64."
      },
      {
        "path": "/properties/gallery",
        "code": "large-data",
        "severity": "warning",
        "message": "An array of \"image-data\" without \"maxItems\": every file is stored in the data as base64."
      },
      {
        "path": "/properties/photo",
        "code": "large-data",
        "severity": "warning",
        "message": "\"image-data\" without \"x-max-width\" or \"x-max-height\" stores photos at full size, megabytes each."
      }
    ]
  },
  {
    "name": "keyword types",
