    },
    "issues": [
      {
        "path": "/properties/fold",
        "code": "keyword-unused",
        "severity": "warning",
        "message": "\"x-collapsed\" has no effect here; it works on \"x-layout\": \"collapsible\"."
      },
      {
        "path": "/properties/labels",
        "code": "keyword-unused",
        "severity": "warning",
        "message": "\"x-min-label\" has no effect here; it works on \"linear-scale\", \"nps\", \"emoji-scale\"."
      },
      {
        "path": "/properties/mask",
        "code": "keyword-unused",
        "severity": "warning",
        "message": "\"x-mask\" has no effect here; it works on text fields."
      },
      {
        "path": "/properties/raw",
        "code": "keyword-unused",
        "severity": "warning",
        "message": "\"x-mask-raw\" has no effect without \"x-mask\"."
      },
      {
        "path": "/properties/rows",
        "code": "keyword-unused",
        "severity": "warning",
        "message": "\"x-rows\" has no effect here; it works on \"textarea\"."
      },
      {
        "path": "/properties/unit",
        "code": "keyword-unused",
        "severity": "warning",
        "message": "\"x-unit\" has no effect here; it works on number fields."
      }
    ]
  },
